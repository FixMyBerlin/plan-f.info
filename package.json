{
  "name": "plan-f.info",
  "version": "0.1.0",
  "private": true,
  "description": "Static Astro rebuild of https://plan-f.info (replaces Gatsby + Strapi)",
  "license": "AGPL-3.0",
  "author": "FixMyCity <hello@fixmycity.de>",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "bun run build:search && astro build",
    "build:local": "ASTRO_USE_NETLIFY_ADAPTER=false KEYSTATIC_STORAGE_KIND=local ASTRO_ENV=production bun run scripts/build-search-index.ts && ASTRO_USE_NETLIFY_ADAPTER=false KEYSTATIC_STORAGE_KIND=local ASTRO_ENV=production astro build",
    "build:search": "bun run scripts/build-search-index.ts",
    "preview": "astro preview",
    "astro": "astro",
    "import:sql": "bun run scripts/import-from-sql.ts",
    "migrate": "bun run scripts/migrate-strapi-to-keystatic.ts",
    "type-check": "astro check && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run type-check && bun run format:check && bun run lint",
    "test:visual": "playwright test",
    "test:pages": "playwright test all-pages --project=desktop"
  },
  "dependencies": {
    "@astrojs/markdoc": "^1.0.6",
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.4.8",
    "clsx": "^2.1.1",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.20.0",
    "marked": "^18.0.5",
    "nuqs": "^2.8.9",
    "react": "^19.2.3",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.50.0",
    "@types/lunr": "^2.3.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
