---
import { Content } from '~/components/Layout'
import Logo from '~/components/Layout/assets/Logo.svg'
import { H1, H2 } from '~/components/Text/Headings'
import { Link } from '~/components/core/links/Link'
import Layout from '~/layouts/Layout.astro'
---

<Layout title="Seite nicht gefunden" noindex>
  <div class="flex h-full flex-col bg-purple-300">
    <div class="bg-green-500 pb-12 pt-20">
      <Content>
        <Link href="/">
          <Logo />
        </Link>
        <H2 className="!font-mono">404</H2>
      </Content>
    </div>
    <div class="flex-grow py-16">
      <Content>
        <H1 className="text-black">Diese Seite gibt es leider nicht (mehr)</H1>
        <div class="mt-10">
          Hier kommst du zur <Link href="/">Startseite</Link>
        </div>
      </Content>
    </div>
  </div>
</Layout>
