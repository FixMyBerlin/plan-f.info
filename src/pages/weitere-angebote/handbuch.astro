---
import { Picture } from 'astro:assets'
import { Content, Hero } from '~/components/Layout'
import { ImageWithCopyright } from '~/components/Layout/ImageWithCopyright'
import { Section } from '~/components/Layout/Section'
import { articleProseClasses } from '~/components/core/articleProseClasses'
import { Link, MailLink } from '~/components/core/links'
import MockUpHandbuch from '~/components/WeitereAngebotePages/assets/MockUp_Handbuch.jpg'
import Layout from '~/layouts/Layout.astro'

const title = 'Plan F Handbuch'
const manualPdf = '/PlanF-Handbuch_2023.pdf'
---

<Layout title={title}>
  <Hero bgColor="bg-green-500" title={title} />
  <Section className={articleProseClasses}>
    <Content>
      <p>
        Im Handbuch sind die Inhalte des Wissensspeichers und weitere Angebote komprimiert und
        übersichtlich zusammengefasst.
      </p>
      <p>Das Handbuch kann als Hardcopy bestellt oder als PDF heruntergeladen werden.</p>
      <p>
        Die ersten 200 gedruckten Exemplare können kostenlos bestellt werden. Hiernach kostet es 25
        € / Exemplar.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-6 items-start">
        <MailLink
          button
          mailto="kontakt@plan-f.info"
          subject="Bestellung Handbuch"
          body={`Vorname, Name
            Adresse
            Gewünschte Anzahl
            optional: E-Mail Adresse und Telefonnummer für Rückfragen
            `}
          type="button"
        >
          Plan F Handbuch (Hardcopy) bestellen
        </MailLink>
        <Link button href={manualPdf}>PDF herunterladen</Link>
      </div>
      <ImageWithCopyright copyright="Plan F Handbuch">
        <Picture
          src={MockUpHandbuch}
          widths={[800, 1280]}
          formats={['avif']}
          fallbackFormat="webp"
          alt="Plan F Handbuch"
          class="mt-12 w-full overflow-hidden"
        />
      </ImageWithCopyright>
    </Content>
  </Section>
</Layout>
